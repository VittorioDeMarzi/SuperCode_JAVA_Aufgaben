DROP TABLE IF EXISTS DIRECTORS;
DROP TABLE IF EXISTS MOVIES;

CREATE TABLE DIRECTORS (
    ID INT PRIMARY KEY,
    VORNAME VARCHAR(50),
    NACHNAME VARCHAR(50)
);

CREATE TABLE MOVIES (
    ID INT PRIMARY KEY,
    TITLE VARCHAR(50),
    GENRE VARCHAR(50),
    RELEASE_YEAR INT,
    DIRECTOR_ID INT,
    FOREIGN KEY (DIRECTOR_ID) REFERENCES DIRECTORS(ID)
);

